flowchart LR
  %% Data-class labels: CFG=config; OPS=operational metadata; EVID=redacted evidence; SECREF=secret reference.
  TASK["TASK_ENVELOPE<br/>OPS / stable IDs"]
  LEDGER["VPS_EXECUTION_LEDGER<br/>SQLite / OPS+EVID"]
  KB["VPS_SHARED_KB<br/>SQLite / redacted EVID"]
  FTS["KB_FTS_RETRIEVAL<br/>chunks_fts lexical retrieval"]
  MIRROR["DESKTOP_LOCAL_MIRROR<br/>fallback, not authority"]
  RECALL["CHECKSUM_RECALL<br/>deterministic handover proof"]
  RELEASE["VERSIONED_RELEASE<br/>Git-derived runtime"]
  BACKUP["VPS_BACKUPS<br/>restorable release/ledger"]
  GIT["GIT_REMOTE<br/>source and documentation"]
  DRIVE["GOOGLE_DRIVE_MASTER_INDEX<br/>transition documentation"]
  SECRET_REF["SECRET_REFERENCES<br/>names only; values excluded"]
  EXTERNAL_DATA["EXTERNAL_OR_CUSTOMER_DATA<br/>not mapped as stored here"]

  TASK -->|EDGE-101 idempotent create| LEDGER
  TASK -->|EDGE-102 redacted preflight/writeback| KB
  KB -->|EDGE-103 token/lexical query; no vector proof| FTS
  LEDGER -->|EDGE-104 checksum-backed read| RECALL
  KB -->|EDGE-105 fresh readback| RECALL
  KB -->|EDGE-106 synchronized fallback path| MIRROR
  RELEASE -->|EDGE-107 deployed source| LEDGER
  RELEASE -->|EDGE-108 backup before mutation| BACKUP
  GIT -->|EDGE-109 commit/push provenance| RELEASE
  KB -->|EDGE-110 redacted summary only| DRIVE
  SECRET_REF -.->|EDGE-111 reference used by authenticated paths| TASK
  EXTERNAL_DATA -.->|EDGE-112 boundary: no raw customer payload in architecture artifacts| KB

  classDef authority fill:#0b5,stroke:#063,color:#fff;
  classDef data fill:#2463eb,stroke:#163c91,color:#fff;
  classDef boundary fill:#f59e0b,stroke:#92400e,color:#111;
  class KB,LEDGER authority;
  class TASK,FTS,MIRROR,RECALL,RELEASE,BACKUP,GIT,DRIVE data;
  class SECRET_REF,EXTERNAL_DATA boundary;
